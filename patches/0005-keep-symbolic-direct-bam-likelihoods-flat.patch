+static bool is_acgt_sequence(const std::string& allele)
+{
+	if (allele.empty()) return false;
+	for (const char base : allele)
+		if (base != 'A' && base != 'C' && base != 'G' && base != 'T')
+			return false;
+	return true;
+}
